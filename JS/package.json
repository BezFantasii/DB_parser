{
  "name": "marketplace-parser-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/domain.test.ts",
    "test:browser": "npm run build && node scripts/browser-test.mjs",
    "test:client": "npm run build && node scripts/client-test.mjs",
    "start": "npm run build && node scripts/launch.mjs",
    "check:live": "npm run build && node scripts/live-check.mjs"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.54.1-build1"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0"
  }
}
