{
  "manifest_version": 3,
  "name": "Сравнить цены — Ozon и Wildberries",
  "description": "Ищите на одной площадке — получайте цены и ссылки со второй в небольшом виджете.",
  "version": "0.3.1",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "unlimitedStorage", "offscreen", "alarms", "scripting", "notifications"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://www.ozon.ru/*", "https://ozon.ru/*", "https://www.wildberries.ru/*", "https://wildberries.ru/*", "https://search.wb.ru/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Сравнить цены", "default_popup": "popup.html"},
  "content_scripts": [{"matches": ["https://www.ozon.ru/*", "https://ozon.ru/*", "https://www.wildberries.ru/*", "https://wildberries.ru/*"], "js": ["widget.js"], "run_at": "document_idle"}],
  "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self';"},
  "cross_origin_embedder_policy": {"value": "require-corp"},
  "cross_origin_opener_policy": {"value": "same-origin"}
}
